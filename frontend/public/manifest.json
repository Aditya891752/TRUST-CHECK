{
  "manifest_version": 3,
  "name": "TrustCheck - AI Reliability Checker",
  "version": "1.0.0",
  "description": "Verify AI answers and factual claims with live evidence citations in real-time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "TrustCheck"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
